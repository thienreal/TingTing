# ==========================================
# SERVER
# ==========================================
PORT=3000

# ==========================================
# DATABASE - POSTGRESQL
# ==========================================
# Dinh dang: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/tingting_db

# Cac bien tach roi (TypeORM co the doc truc tiep thay cho DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=tingting_db

# Aliases for Docker Compose (PostgreSQL Image expects these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=tingting_db

# ==========================================
# TYPEORM
# ==========================================
# true: TypeORM tu dong tao/cap nhat bang khi chay (Chi dung khi DEV, KHONG dung Production)
TYPEORM_SYNC=true
# true: Hien thi cac cau lenh SQL ma TypeORM thuc thi ra terminal (Giup debug)
TYPEORM_LOGGING=true

# ==========================================
# BẢOVMAT - JWT
# ==========================================
# Khoa bi mat de ky va xac minh JWT Token. Thay bang 1 chuoi ngau nhien, dai, kho doan.
JWT_SECRET=your_super_secret_key_change_this
# Thoi han het han cua Access Token (vd: 7d = 7 ngay, 24h = 24 gio)
JWT_EXPIRES_IN=7d

# ==========================================
# OTP (Dang nhap bang so dien thoai)
# ==========================================
# Thoi gian hieu luc cua ma OTP (tinh bang giay). 300 = 5 phut.
OTP_EXPIRY_SECONDS=300

# ==========================================
# WEBSOCKET (Real-time Notification)
# ==========================================
WEBSOCKET_PORT=3001

# ==========================================
# BUSINESS CONFIG (TingTing)
# ==========================================
# WebSocket port for real-time notifications
WEBSOCKET_PORT=3001

# Ti le doi tien -> diem (Vi du: 1000 = 1000 VND duoc 1 diem)
POINTS_RATIO=1000

# Cau hinh han muc len hang (JSON format)
MEMBERSHIP_TIERS_CONFIG={"STANDARD":0,"SILVER":1000,"GOLD":5000,"PLATINUM":20000}
